{
  "name": "omnikey-ai",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "npm run test -w server",
    "build": "npm run build -w server && npm run build -w client",
    "build:server": "npm run build -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.1"
    },
    "vite": {
      "esbuild": "^0.28.1"
    },
    "uuid": "^11.1.1",
    "google-gax": {
      "uuid": "^11.1.1"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    }
  }
}
