# Server port (default: 3001)
PORT=3001

# Server encryption key for API key storage (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-64-char-hex-key-here

# Comma-separated extra origins allowed to call the API from a browser (CORS whitelist).
# Required if deploying backend on Render and frontend on Vercel.
# DASHBOARD_ORIGINS=https://your-frontend-app.vercel.app

# MongoDB Connection String (Atlas Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/omnikey-ai

# Firebase Project ID (for ID token verification)
FIREBASE_PROJECT_ID=omnikey-ai

# Resend API Key for contact form emails routing (https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# --- Client Environment Variables (for Vercel deployment) ---
# VITE_API_URL=https://your-backend-app.onrender.com
